folder GlobalSimVars {
    var Timer = 0;
    var Grav = (0, 9.8);
}

folder Input {
    var Horiz = 0;
    var TimeFromLastHoriz = 0;
    var Vert = 0;
    var HorizOffset = 0;
    var VertOffset = 0;
    var Input = (-HorizOffset + Horiz, -VertOffset + Vert);
    
    var maxThrustInput = 10;
    var AccelDir = (0,0);
    var RotationSpeed = 0;
    var CurrentThrust = 0;
}


folder RocketVarables {
    var Weight = 205;
    var FullFuelWeight = 120;
    var dryWeight = 85;
    var FuelPercent = 100;
    var FuelLossSpeedAtmaxThrust = 1;
    var MaxThrust = 74000;
    var CurrentRotation = 0;
    var Velocity = (0,0);
}

folder BackgroundStuff {
    var BackgroundOffset = (0,0);
}

ticker(0) {
    Update(Math.dt)
}

/* DT needs to be div by 1000 to get seconds*/
function Update(DeltaTime) {
    Timer = Timer+DeltaTime/1000;
    GetInput()
    CalcFuel(DeltaTime)
    UpdateRockectPos(DeltaTime)
}

function UpdateRockectPos(DeltaTime) {
    CurrentRotation = CurrentRotation + RotationSpeed * (DeltaTime/1000);
    AccelDir = (-CurrentThrust * Math.sin(CurrentRotation), CurrentThrust * Math.cos(CurrentRotation));
    Velocity = Velocity + ((((AccelDir / 100) * MaxThrust)/Weight) * (DeltaTime/1000)) - (Grav * (DeltaTime/1000));
    
    BackgroundOffset = BackgroundOffset - (Velocity * (DeltaTime/1000));
}

function GetInput() {
    if (FuelPercent > 0) {
        if (CurrentThrust > maxThrustInput) {
            CurrentThrust = maxThrustInput;
        } else if (CurrentThrust < 0) {
            CurrentThrust = 0;
        } else if (Horiz > HorizOffset) {
            RotationSpeed = RotationSpeed-1;
        } else if (Horiz < HorizOffset) {
            RotationSpeed = RotationSpeed+1;
        } else if (Vert > VertOffset) {
            CurrentThrust = CurrentThrust+1;
        } else if (Vert < VertOffset) {
            CurrentThrust = CurrentThrust-1;
        }
    } else {
        CurrentThrust = 0;
    }
    HorizOffset = Horiz;
    VertOffset = Vert;
}

function CalcFuel(DeltaTime) {
    if (FuelPercent > 0) {
        if (FuelLossSpeedAtmaxThrust*AccelDir.y/maxThrustInput*DeltaTime/1000 >= 0) {
            FuelPercent = FuelPercent - FuelLossSpeedAtmaxThrust*(AccelDir.y/maxThrustInput)*(DeltaTime/1000);
        }
    } else {
        FuelPercent = 0;
    }
    Weight = dryWeight + FullFuelWeight*(FuelPercent/100);
}


function Reset() {
    FuelPercent = 100;
    AccelDir = (0,0);
    BackgroundOffset = (0,0);
    Velocity = (0,0);
    RotationSpeed = 0;
    CurrentThrust = 0;
    CurrentRotation = 0;
}





